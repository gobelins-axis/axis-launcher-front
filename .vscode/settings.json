{
    "files.associations": {
        "*.html": "vue-html,"
    },
    "emmet.includeLanguages": {
        "vue-html": "html",
        "vue": "html",
        "javascript": "html"
    },
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.fixAll.eslint": "explicit"
    }
}
